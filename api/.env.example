# ══════════════════════════════════════════════════════════════════════
# Doc-I Platform — Environment Configuration
# Copy this file to .env and fill in all required values.
#
# Required fields have no default and MUST be set before starting.
# Optional fields have sensible defaults shown below.
# ══════════════════════════════════════════════════════════════════════


# ── Application ────────────────────────────────────────────────────────
ENVIRONMENT=development

# Must be at least 16 characters in development, 32 in production.
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-this-before-production

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed origins
# Example: https://app.yourfirm.ng,https://admin.yourfirm.ng
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8502


# ── API server ─────────────────────────────────────────────────────────
API_PORT=8012
API_INTERNAL_PORT=8012


# ── Demo ───────────────────────────────────────────────────────────────
DEMO_PORT=8502


# ── Python / Docker ────────────────────────────────────────────────────
PYTHON_VERSION=3.12
REQUIREMENTS_FILE=requirements/local.txt


# ── PostgreSQL ─────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_EXTERNAL_PORT=5435
DB_NAME=doci
DB_USER=doci
DB_PASSWORD=changeme

# Assembled automatically by the settings module — do not set manually
# DATABASE_URL=postgresql://doci:changeme@postgres:5432/doci


# ── Redis ──────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6380

# Assembled automatically — do not set manually
# REDIS_URL=redis://redis:6379/0


# ── MinIO (S3-compatible object storage) ───────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001


# ── Anthropic / Claude ─────────────────────────────────────────────────
# Required — app will refuse to start without these.
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model to use for classification and extraction
CLAUDE_MODEL=claude-sonnet-4-20250514

# Maximum tokens per Claude response (1000–4096 recommended)
CLAUDE_MAX_TOKENS=1500


# ── Azure Document Intelligence (optional) ─────────────────────────────
# If not set, the worker falls back to sending raw images to Claude.
# Get your endpoint and key from the Azure portal.
AZURE_DOCINT_ENDPOINT=
AZURE_DOCINT_KEY=
